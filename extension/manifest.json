{
  "manifest_version": 3,
  "name": "ReelForge",
  "version": "0.1.0",
  "description": "Needs the ReelForge app on this computer. Attaches your video and fills in the text on TikTok, YouTube, Instagram and X. It can press Post too, where you switch that on.",
  "key": "",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ReelForge",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://studio.youtube.com/*",
    "https://www.youtube.com/*",
    "https://www.tiktok.com/*",
    "https://www.instagram.com/*",
    "https://x.com/*",
    "https://reelforge.tools/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/pair*", "http://127.0.0.1/post/*"],
      "js": ["content/local.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://reelforge.tools/*"],
      "js": ["content/site.js"],
      "run_at": "document_start"
    }
  ]
}
